@inherits LayoutComponentBase
@using DafornoMail.Client.Shared.Components

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @if (!_isLoading)
    {
        <MudAppBar Elevation="0" Color="Color.Primary" Dense="true">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => _drawerOpen = !_drawerOpen)" />
            <MudText Typo="Typo.h6" Class="ml-2">Daforno Mail</MudText>
            
            <MudSpacer />
            
            <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Inherit" />
            <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" />
            
            <MudMenu Direction="Direction.Bottom" OffsetY="true" Dense="true">
                <ActivatorContent>
                    <MudAvatar Color="Color.Surface" Class="ml-2">
                        <MudText>@_userInitials</MudText>
                    </MudAvatar>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem>
                        <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Class="mr-2" />
                        <MudText>Profile</MudText>
                    </MudMenuItem>
                    <MudMenuItem>
                        <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />
                        <MudText>Settings</MudText>
                    </MudMenuItem>
                    <MudDivider />
                    <MudMenuItem OnClick="Logout">
                        <MudIcon Icon="@Icons.Material.Filled.ExitToApp" Class="mr-2" />
                        <MudText>Logout</MudText>
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Responsive">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6" Class="ml-2">Daforno Mail</MudText>
            </MudDrawerHeader>
            
            <MudNavMenu>
                <MudNavLink Href="/inbox" Match="NavLinkMatch.Prefix">
                    <MudIcon Icon="@Icons.Material.Filled.Inbox" Class="mr-3" />
                    Inbox
                    <MudBadge BadgeContent="5" Color="Color.Error" Size="Size.Small" Class="ml-2" />
                </MudNavLink>
                
                <MudNavLink Href="/starred" Match="NavLinkMatch.Prefix">
                    <MudIcon Icon="@Icons.Material.Filled.Star" Class="mr-3" />
                    Starred
                </MudNavLink>
                
                <MudNavLink Href="/sent" Match="NavLinkMatch.Prefix">
                    <MudIcon Icon="@Icons.Material.Filled.Send" Class="mr-3" />
                    Sent
                </MudNavLink>
                
                <MudNavLink Href="/drafts" Match="NavLinkMatch.Prefix">
                    <MudIcon Icon="@Icons.Material.Filled.Drafts" Class="mr-3" />
                    Drafts
                </MudNavLink>
                
                <MudNavLink Href="/trash" Match="NavLinkMatch.Prefix">
                    <MudIcon Icon="@Icons.Material.Filled.Delete" Class="mr-3" />
                    Trash
                </MudNavLink>
                
                <MudDivider Class="my-4" />
                
                <MudNavLink Href="/labels" Match="NavLinkMatch.Prefix">
                    <MudIcon Icon="@Icons.Material.Filled.Label" Class="mr-3" />
                    Labels
                </MudNavLink>
                
                <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-3" />
                    Settings
                </MudNavLink>
            </MudNavMenu>
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
                @Body
            </MudContainer>
        </MudMainContent>
    }
    else
    {
        <MudContainer Class="d-flex justify-center align-center" Style="height: 100vh;">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" />
        </MudContainer>
    }
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isLoading = true;
    private string _userInitials = "US";
    
    [Inject] private NavigationManager Navigation { get; set; } = null!;
    [Inject] private IAuthService AuthService { get; set; } = null!;
    
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load user data here
            await Task.Delay(1000); // Simulate loading
            _isLoading = false;
        }
        catch (Exception ex)
        {
            // Handle error
            _isLoading = false;
        }
    }
    
    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/");
    }
}
